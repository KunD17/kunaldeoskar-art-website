---
// One artwork thumbnail + caption, linking to its detail page.
// Used on the Home page and the Works page.
import { Image } from 'astro:assets';
import type { Artwork } from '../lib/artworks';

interface Props { artwork: Artwork; eager?: boolean }
const { artwork, eager = false } = Astro.props;
const { title, year, series, image, alt } = artwork.data;
---
<li class="card" data-series={series ?? ''} data-year={year}>
  <a href={`/works/${artwork.id}/`}>
    <Image
      src={image}
      alt={alt}
      widths={[400, 600, 900, 1200]}
      sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 420px"
      loading={eager ? 'eager' : 'lazy'}
    />
    <p class="caption"><strong>{title}</strong>, <span>{year}</span></p>
  </a>
</li>
