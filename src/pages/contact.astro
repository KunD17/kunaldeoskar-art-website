---
// CONTACT: email + Instagram. The actual address/handle are set in src/settings.ts.
import Base from '../layouts/Base.astro';
import { EMAIL, INSTAGRAM_HANDLE } from '../settings';
---
<Base title="Contact" description="Get in touch about commissions, exhibitions or available works.">
  <h1 class="page-title">Contact</h1>

  <div class="prose">
    <p class="muted">For commissions, exhibitions or enquiries about available works, please get in touch.</p>

    <dl>
      <dt>Email</dt>
      <dd><a href={`mailto:${EMAIL}`}>{EMAIL}</a></dd>
      <dt>Instagram</dt>
      <dd><a href={`https://www.instagram.com/${INSTAGRAM_HANDLE}/`} rel="me noopener" target="_blank">@{INSTAGRAM_HANDLE}</a></dd>
    </dl>
  </div>
</Base>

<style>
  dl { display: grid; grid-template-columns: auto 1fr; gap: 12px 32px; margin-top: 32px; font-size: 1.1rem; }
  dt { color: var(--muted); font-size: .95rem; padding-top: 2px; }
  dd { margin: 0; word-break: break-word; }
</style>
